# Copy to .env and fill with credentials from your SMTP/email provider.
# Keep .env private; never upload it or commit it to Git.
PREDICTAI_SMTP_HOST=smtp.example.com
PREDICTAI_SMTP_PORT=587
PREDICTAI_SMTP_FROM=PredictAI <no-reply@example.com>
PREDICTAI_SMTP_USER=your-smtp-username
PREDICTAI_SMTP_PASSWORD=your-smtp-password
PREDICTAI_SMTP_STARTTLS=true
PREDICTAI_SMTP_SSL=false
# For local testing use http://localhost:8501. For hosted deployment use your HTTPS app URL.
PREDICTAI_PUBLIC_URL=http://localhost:8501
# Optional: keep the SQLite database at a path outside the app folder.
# PREDICTAI_AUTH_DB=/absolute/path/to/predictai_auth.db
