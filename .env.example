# Copy these variables into your local .env file and fill in your own credentials.
# Never commit or share the real .env file.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional: special-access code. Keep private; never commit a real value.
PREDICTAI_SPECIAL_ACCESS_CODE=replace-with-a-long-random-secret
# Optional: account database location (defaults to ~/.predictai/accounts.db)
# PREDICTAI_ACCOUNTS_DB=/absolute/path/to/accounts.db

# Phase 9 owner account: choose a username and a long private one-time setup secret.
# The first account registered with this exact username must supply the setup secret.
PREDICTAI_OWNER_USERNAME=your_owner_username
PREDICTAI_OWNER_SETUP_SECRET=replace-with-a-long-random-owner-setup-secret
